{
  "_version": "1.60.0",
  "sap.app": {
    "id": "rmc.app",
    "type": "application",
    "title": "Raw Material Content Management",
    "description": "Commodity price change, raw-material content and retrospective impact management",
    "applicationVersion": { "version": "0.1.0" },
    "dataSources": {
      "rmcService": { "uri": "/odata/v4/rmc/", "type": "OData", "settings": { "odataVersion": "4.0" } },
      "adminService": { "uri": "/odata/v4/admin/", "type": "OData", "settings": { "odataVersion": "4.0" } }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "rmc.app.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.f": {}, "sap.ui.layout": {} }
    },
    "models": {},
    "resources": { "css": [{ "uri": "css/style.css" }] }
  }
}
